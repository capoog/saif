    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
