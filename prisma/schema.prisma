// نموذج البيانات — المرحلة 1 (النواة) + المرحلة 2 (البيع والعملاء).
// كل المبالغ Decimal. كل حركة مالية = قيد في دفتر الأستاذ (JournalEntry/JournalLine).
// الجداول الظاهرة للمستخدم (Transaction, InventoryBatch, Order, Payment) بتشاور على قيودها.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL = الرابط الـ pooled للتشغيل، DIRECT_URL = الرابط المباشر للـ migrations
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── المستخدمين والأمان ─────────────────────────

enum Role {
  owner
  sales
  freelancer
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          Role        @default(owner)
  commissionPct Decimal?    @db.Decimal(5, 2)
  freelancerId  String?     @unique
  freelancer    Freelancer? @relation(fields: [freelancerId], references: [id])
  totpSecret    String?
  totpEnabled   Boolean     @default(false)
  failedLogins  Int         @default(0)
  lockedUntil   DateTime?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // create | update | delete | override | close | reopen ...
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── المحركات ─────────────────────────

model Engine {
  id            String   @id @default(cuid())
  code          String   @unique // ECOM | B2B | AGENCY | CARS | SUPPLY
  name          String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  // نوع النشاط: STORE | RESTAURANT | CAFE | FOOD_TRUCK | STALL | SERVICES | CORE (الخمسة الأساسية)
  kind          String   @default("CORE")
  // أقصى نسبة من رأس المال مسموح يشتغل فيها النشاط (تنبيه) — فاضي = بدون حد
  maxCapitalPct Decimal? @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime @default(now())

  products     Product[]
  journalLines JournalLine[]
  orders       Order[]
  transactions Transaction[]
  deals        Deal[]
  adCampaigns  AdCampaign[]
}

// ───────────────────────── دفتر الأستاذ ─────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// التصنيف اللي حساب رأس المال بيعتمد عليه
enum AccountKind {
  CASH // بنك / صندوق / حساب الضريبة
  RESTRICTED_CASH // نقد محجوز (هامش ضمان بنكي) — من رأس المال لكن مو من السيولة
  WALLET // مدى / Apple Pay / تابي — مستحقات تسوية
  INVENTORY
  CUSTOMER // رصيد العملاء لكل طلب: مدين = ذمة، دائن = عربون
  SUPPLIER_PAYABLE
  FREELANCER_PAYABLE
  LOAN
  VAT_PAYABLE
  ZAKAT_PROVISION
  OWNER_CAPITAL
  PARTNER_CAPITAL
  REVENUE
  OTHER_INCOME
  COGS
  EXPENSE
}

model LedgerAccount {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  type         AccountType
  kind         AccountKind
  // يظهر في شاشة "الحسابات والنقد" كحساب فعلي بيتحرك فيه فلوس
  isMoney      Boolean     @default(false)
  isTaxReserve Boolean     @default(false)
  system       Boolean     @default(true)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  lines JournalLine[]
}

model JournalEntry {
  id           String        @id @default(cuid())
  date         DateTime
  description  String
  sourceType   String // TRANSACTION | BATCH | ORDER_PAYMENT | ORDER_DELIVERY | ORDER_RETURN | ADJUSTMENT | RECONCILE | ZAKAT | OPENING
  sourceId     String?
  // لتجميع رصيد العميل لكل طلب (الذمم والعرابين)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  projectId    String?
  project      BigProject?   @relation(fields: [projectId], references: [id])
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")
  createdById  String?
  createdAt    DateTime      @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([sourceType, sourceId])
  @@index([orderId])
  @@index([projectId])
}

model JournalLine {
  id           String        @id @default(cuid())
  entryId      String
  entry        JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId    String
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  debit        Decimal       @default(0) @db.Decimal(14, 2)
  credit       Decimal       @default(0) @db.Decimal(14, 2)
  engineId     String?
  engine       Engine?       @relation(fields: [engineId], references: [id])
  // دفتر فرعي للموردين: مستحقات كل مورد لوحده
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  freelancerId String?
  salesUserId  String?
  memo         String?

  @@index([accountId])
  @@index([engineId])
  @@index([supplierId])
  @@index([freelancerId])
  @@index([salesUserId])
}

// ───────────────────────── الحركات النقدية ─────────────────────────

enum TransactionType {
  DEPOSIT // إيداع (رأس مال مالك / شريك / قرض / دخل آخر)
  WITHDRAWAL // سحب (مسحوبات مالك / سداد قرض / سداد التزام / سداد ضريبة)
  TRANSFER
  EXPENSE
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  date           DateTime
  amount         Decimal         @db.Decimal(14, 2)
  accountId      String // الحساب النقدي المتأثر (من)
  toAccountId    String? // في التحويل، أو الحساب المقابل (ضريبة، قرض، رأس مال…)
  category       String? // تصنيف المصروف أو نوع الإيداع/السحب
  engineId       String?
  engine         Engine?         @relation(fields: [engineId], references: [id])
  note           String?
  refType        String? // ORDER | CAR_DEAL | PROJECT ... (ربط اختياري)
  refId          String?
  journalEntryId String?         @unique
  createdById    String?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?

  @@index([date])
}

// ───────────────────────── المنتجات والمخزون ─────────────────────────

enum ProductStatus {
  PRIORITY_TEST // أولوية للاختبار
  TESTING // قيد الاختبار
  ACTIVE // مستمر
  STOPPED // موقوف
  LATER // لاحقًا
  AVOID // تجنّب
}

enum ProductKind {
  GOODS // منتج أو مادة بمخزون
  BOX // بوكس بمكونات (BOM) — المخزون بيتخصم من المكونات
  SERVICE // خدمة بدون مخزون (اشتراك وكالة…)
}

model Product {
  id                String        @id @default(cuid())
  number            Int?          @unique
  name              String
  category          String
  kind              ProductKind   @default(GOODS)
  // رمز المنتج في المتجر (سلة/زد) — للربط التلقائي
  sku               String?       @unique
  engineId          String
  engine            Engine        @relation(fields: [engineId], references: [id])
  status            ProductStatus @default(LATER)
  unit              String        @default("قطعة")
  defaultSellPrice  Decimal?      @db.Decimal(14, 2)
  // تكلفة تقديرية للتسعير قبل أول شراء
  estimatedUnitCost Decimal?      @db.Decimal(14, 4)
  // ملاحظات تقديرية من ملف البحث — السعر الفعلي يتحدد عند أول شراء
  buyPriceRange     String?
  sellPriceRange    String?
  grossMarginNote   String?
  turnover          String?
  b2b               String?
  brandPotential    String?
  regulatoryNote    String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  batches     InventoryBatch[]
  orderItems  OrderItem[]
  recipe      RecipeLine[]        @relation("BoxRecipe")
  usedIn      RecipeLine[]        @relation("RecipeComponent")
  poItems     PurchaseOrderItem[]
  quoteItems  QuoteItem[]
  adCampaigns AdCampaign[]
}

// مكونات البوكس: كل بوكس = مجموعة مواد بكميات (ممكن كسور: 0.5 كجم تمر)
model RecipeLine {
  id          String  @id @default(cuid())
  boxId       String
  box         Product @relation("BoxRecipe", fields: [boxId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("RecipeComponent", fields: [componentId], references: [id])
  quantity    Decimal @db.Decimal(14, 3)

  @@unique([boxId, componentId])
}

model InventoryBatch {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  receivedAt      DateTime
  quantity        Decimal   @db.Decimal(14, 3)
  remaining       Decimal   @db.Decimal(14, 3)
  // تكلفة الوحدة شاملة الشحن
  unitCost        Decimal   @db.Decimal(14, 4)
  totalCost       Decimal   @db.Decimal(14, 2)
  paidAmount      Decimal   @db.Decimal(14, 2)
  paidFromId      String?
  supplierName    String?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  note            String?
  journalEntryId  String?   @unique
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  consumptions BatchConsumption[]

  @@index([productId, receivedAt])
}

// كل خصم من دفعة (بيع بـ FIFO أو تسوية جرد)
model BatchConsumption {
  id          String         @id @default(cuid())
  batchId     String
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  quantity    Decimal        @db.Decimal(14, 3) // موجب = خصم، سالب = رجوع للمخزون
  unitCost    Decimal        @db.Decimal(14, 4)
  // التكلفة الفعلية المخصومة (آخر وحدات الدفعة تاخد الباقي بالظبط عشان مفيش فروقات تقريب)
  cost        Decimal        @db.Decimal(14, 2)
  date        DateTime
  orderItemId String?
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id])
  reason      String // SALE | RETURN | ADJUSTMENT
  createdAt   DateTime       @default(now())

  @@index([batchId])
  @@index([orderItemId])
}

// ───────────────────────── العملاء والطلبات ─────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  type      String    @default("individual") // individual | company
  phone     String?
  email     String?
  city      String?
  sector    String?
  contact   String?
  channel   String?
  notes     String?
  ownerId   String? // مندوب المبيعات المسؤول (المرحلة 3)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  orders        Order[]
  deals         Deal[]
  quotes        Quote[]
  activities    Activity[]
  contracts     B2BContract[]
  carsBought    CarDeal[]
  subscriptions Subscription[]
  agencyTasks   AgencyTask[]
  projects      BigProject[]

  @@index([phone])
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model Order {
  id                 String        @id @default(cuid())
  number             Int           @unique @default(autoincrement())
  date               DateTime
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  channel            String
  engineId           String
  engine             Engine        @relation(fields: [engineId], references: [id])
  status             OrderStatus   @default(NEW)
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      String?
  subtotal           Decimal       @db.Decimal(14, 2) // مجموع البنود
  discount           Decimal       @default(0) @db.Decimal(14, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(14, 2) // شحن محصّل من العميل
  vatAmount          Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2) // الإجمالي المستحق من العميل
  netRevenue         Decimal       @db.Decimal(14, 2) // الإجمالي بدون الضريبة
  pricesIncludeVat   Boolean       @default(true)
  vatRate            Decimal       @default(0) @db.Decimal(5, 4)
  deliveredAt        DateTime?
  returnedAt         DateTime?
  cancelledAt        DateTime?
  officialInvoiceNo  String?
  officialInvoiceUrl String?
  // عقد B2B: كل دفعة تسليم = طلب مرتبط بالعقد
  contractId         String?
  contract           B2BContract?  @relation(fields: [contractId], references: [id])
  scheduledFor       DateTime?
  note               String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  items          OrderItem[]
  payments       Payment[]
  journalEntries JournalEntry[]

  // طلب جاي من متجر إلكتروني
  externalSource String?
  externalId     String?

  @@unique([externalSource, externalId])
  @@index([date])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(14, 2)
  lineTotal Decimal  @db.Decimal(14, 2)
  // تكلفة البضاعة المباعة بعد خصم FIFO (تتحدد عند التسليم)
  cogs      Decimal? @db.Decimal(14, 2)

  consumptions BatchConsumption[]
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  date           DateTime
  amount         Decimal   @db.Decimal(14, 2) // سالب = استرداد للعميل
  method         String
  accountId      String
  note           String?
  journalEntryId String?   @unique
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([orderId])
}

// ───────────────────────── الخطة والإغلاق الأسبوعي ─────────────────────────

model WeeklyTarget {
  week               Int      @id
  days               String
  weekStartDate      DateTime @db.Date
  startCapitalTarget Decimal  @db.Decimal(14, 2)
  endCapitalTarget   Decimal  @db.Decimal(14, 2)
  requiredNetProfit  Decimal  @db.Decimal(14, 2)
}

model WeeklySnapshot {
  id                String   @id @default(cuid())
  week              Int      @unique
  asOf              DateTime
  capital           Decimal  @db.Decimal(14, 2)
  target            Decimal  @db.Decimal(14, 2)
  gap               Decimal  @db.Decimal(14, 2)
  gapPct            Decimal  @db.Decimal(8, 4)
  status            String // above | on | below | danger
  breakdown         Json // مكونات رأس المال بالكامل
  engines           Json // ربح وعائد كل محرك في الأسبوع
  suggestedDecision String
  actualDecision    String?
  reconciliation    Json? // فروقات الحسابات والجرد
  closedById        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ZakatAccrual {
  id             String   @id @default(cuid())
  month          String   @unique // YYYY-MM
  base           Decimal  @db.Decimal(14, 2)
  amount         Decimal  @db.Decimal(14, 2)
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())
}

// ───────────────────────── الموردين وأوامر الشراء ─────────────────────────

model Supplier {
  id        String    @id @default(cuid())
  name      String
  type      String // مصنع | موزع | سوق جملة | منشأة تعبئة | محمصة | أخرى
  phone     String?
  contact   String?
  city      String?
  rating    Int? // 1..5
  notes     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  batches        InventoryBatch[]
  purchaseOrders PurchaseOrder[]
  journalLines   JournalLine[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      Int                 @unique @default(autoincrement())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  date        DateTime
  expectedAt  DateTime?
  status      PurchaseOrderStatus @default(ORDERED)
  // شحن وجمارك على الأمر كله — بتتوزع على البنود بنسبة القيمة عند الاستلام
  extraCosts  Decimal             @default(0) @db.Decimal(14, 2)
  receivedAt  DateTime?
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Decimal       @db.Decimal(14, 3)
  unitPrice Decimal       @db.Decimal(14, 4)
}

// ───────────────────────── CRM ─────────────────────────

enum DealStage {
  LEAD // عميل محتمل
  CONTACTED // تم التواصل
  INTERESTED // مهتم
  QUOTE_SENT // عرض سعر مرسل
  NEGOTIATION // تفاوض
  DEPOSIT // عربون مستلم
  WON // تم التسليم والتحصيل
  LOST // خسرناه
}

model Deal {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  title          String
  engineId       String?
  engine         Engine?   @relation(fields: [engineId], references: [id])
  stage          DealStage @default(LEAD)
  value          Decimal?  @db.Decimal(14, 2)
  nextFollowUpAt DateTime?
  lostReason     String?
  note           String?
  ownerId        String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  quotes     Quote[]
  activities Activity[]

  @@index([stage])
  @@index([nextFollowUpAt])
}

// كل تواصل (مكالمة، واتساب، زيارة…) — عدّاد التواصلات اليومي بيتحسب من هنا
model Activity {
  id         String    @id @default(cuid())
  date       DateTime
  type       String // call | whatsapp | visit | email | dm | other
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())

  @@index([date])
}

// ───────────────────────── عروض الأسعار وعقود B2B ─────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id               String      @id @default(cuid())
  number           Int         @unique @default(autoincrement())
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  dealId           String?
  deal             Deal?       @relation(fields: [dealId], references: [id])
  date             DateTime
  validUntil       DateTime
  status           QuoteStatus @default(DRAFT)
  discount         Decimal     @default(0) @db.Decimal(14, 2)
  shippingFee      Decimal     @default(0) @db.Decimal(14, 2)
  subtotal         Decimal     @db.Decimal(14, 2)
  vatAmount        Decimal     @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  vatRatePct       Decimal     @default(0) @db.Decimal(5, 2)
  pricesIncludeVat Boolean     @default(true)
  depositPct       Decimal     @default(50) @db.Decimal(5, 2)
  terms            String?
  note             String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items     QuoteItem[]
  contract  B2BContract?
  // عرض سعر لسيارة (المواصفات بتطلع في الـ PDF)
  carDealId String?
  carDeal   CarDeal?     @relation(fields: [carDealId], references: [id])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0)
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model B2BContract {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  quoteId     String?        @unique
  quote       Quote?         @relation(fields: [quoteId], references: [id])
  signedAt    DateTime
  status      ContractStatus @default(ACTIVE)
  depositPct  Decimal        @db.Decimal(5, 2)
  total       Decimal        @db.Decimal(14, 2)
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())

  salesUserId       String?
  commissionAccrued Decimal? @db.Decimal(14, 2)

  orders Order[]
}

// ───────────────────────── الإعلانات ─────────────────────────

model AdCampaign {
  id        String   @id @default(cuid())
  name      String
  channel   String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  engineId  String
  engine    Engine   @relation(fields: [engineId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  spends AdSpend[]
}

model AdSpend {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      AdCampaign @relation(fields: [campaignId], references: [id])
  date          DateTime
  amount        Decimal    @db.Decimal(14, 2)
  orders        Int        @default(0)
  revenue       Decimal    @default(0) @db.Decimal(14, 2)
  transactionId String?    @unique
  createdAt     DateTime   @default(now())
  deletedAt     DateTime?

  @@index([date])
}

// ───────────────────────── السيارات ─────────────────────────

enum CarDealType {
  BROKERAGE // وساطة: السيارة لشخص ثاني وأنا آخذ عمولة
  PURCHASE // شراء وبيع: السيارة ملكي
}

enum CarDealStatus {
  EVALUATING // تحت الدراسة (شراء وبيع قبل الشراء)
  LISTED // معروضة (وساطة)
  OWNED // اشتريتها ومعروضة للبيع
  SOLD
  CANCELLED
}

model CarDeal {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  type            CarDealType
  status          CarDealStatus
  make            String // الشركة والموديل: تويوتا كامري
  year            Int
  mileage         Int?
  color           String?
  specs           String? // الفئة والمواصفات
  vin             String?
  source          String? // حراج، معرض، مالك مباشر…
  ownerName       String? // صاحب السيارة (وساطة)
  ownerPhone      String?
  // أسعار إعلانات مشابهة (حتى 10) ومتوسطها
  marketPrices    Json          @default("[]")
  marketAvg       Decimal?      @db.Decimal(14, 2)
  askingPrice     Decimal?      @db.Decimal(14, 2)
  // وساطة: عمولة ثابتة أو نسبة من سعر البيع
  commissionType  String? // FIXED | PERCENT
  commissionValue Decimal?      @db.Decimal(14, 2)
  // شراء: قائمة الفحص قبل الشراء
  checklist       Json          @default("{}")
  purchasePrice   Decimal?      @db.Decimal(14, 2)
  purchasedAt     DateTime?
  salePrice       Decimal?      @db.Decimal(14, 2)
  soldAt          DateTime?
  buyerId         String?
  buyer           Customer?     @relation(fields: [buyerId], references: [id])
  commission      Decimal?      @db.Decimal(14, 2)
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  costs  CarDealCost[]
  quotes Quote[]

  @@index([status])
}

// تكاليف التجهيز (فحص، تلميع، إصلاح…) — بتدخل في تكلفة السيارة
model CarDealCost {
  id             String   @id @default(cuid())
  carDealId      String
  carDeal        CarDeal  @relation(fields: [carDealId], references: [id])
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(14, 2)
  accountId      String
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())
}

// ───────────────────────── الوكالة الرقمية ─────────────────────────

model Freelancer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  skills    String?
  rateNote  String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  user  User?
  tasks AgencyTask[]
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  service         String
  amount          Decimal            @db.Decimal(14, 2)
  startDate       DateTime
  nextBillingDate DateTime
  status          SubscriptionStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime           @default(now())

  charges SubscriptionCharge[]
  tasks   AgencyTask[]
}

// كل شهر ينسجل = طلب خدمة (إيراد + ذمة لين التحصيل)
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  period         String
  date           DateTime
  amount         Decimal      @db.Decimal(14, 2)
  orderId        String       @unique
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, period])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DELIVERED
  APPROVED
  CANCELLED
}

model AgencyTask {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  title          String
  description    String?
  dueAt          DateTime?
  freelancerId   String?
  freelancer     Freelancer?   @relation(fields: [freelancerId], references: [id])
  cost           Decimal       @default(0) @db.Decimal(14, 2)
  status         TaskStatus    @default(TODO)
  deliveryUrl    String?
  deliveryNote   String?
  deliveredAt    DateTime?
  approvedAt     DateTime?
  journalEntryId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([freelancerId, status])
}

// ───────────────────────── المشاريع الكبيرة ─────────────────────────

enum ProjectType {
  QUALIFICATION
  PRIVATE_SUPPLY
  GOV_TENDER
  SUBCONTRACT
  DIRECT_CONTRACT
}

enum ProjectStatus {
  BIDDING
  ACTIVE
  COMPLETED
  LOST
  CANCELLED
}

model BigProject {
  id                     String        @id @default(cuid())
  number                 Int           @unique @default(autoincrement())
  type                   ProjectType
  name                   String
  customerId             String
  customer               Customer      @relation(fields: [customerId], references: [id])
  status                 ProjectStatus @default(BIDDING)
  value                  Decimal       @db.Decimal(14, 2)
  advancePct             Decimal       @default(0) @db.Decimal(5, 2)
  bankGuarantee          Decimal       @default(0) @db.Decimal(14, 2)
  guaranteeMargin        Decimal       @default(0) @db.Decimal(14, 2)
  expectedCollectionDays Int           @default(60)
  startDate              DateTime?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  invoices       ProjectInvoice[]
  journalEntries JournalEntry[]
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

// مستخلص
model ProjectInvoice {
  id               String        @id @default(cuid())
  projectId        String
  project          BigProject    @relation(fields: [projectId], references: [id])
  number           Int
  date             DateTime
  amount           Decimal       @db.Decimal(14, 2)
  vatAmount        Decimal       @default(0) @db.Decimal(14, 2)
  advanceDeduction Decimal       @default(0) @db.Decimal(14, 2)
  status           InvoiceStatus @default(DRAFT)
  approvedAt       DateTime?
  paidAt           DateTime?
  note             String?
  createdAt        DateTime      @default(now())

  @@unique([projectId, number])
}

enum ExternalOrderStatus {
  SYNCED // انسجل في النظام
  NEEDS_MAPPING // فيه منتج ما عرفناه — يحتاج ربط SKU
  ERROR // خطأ (مخزون ناقص مثلًا) — يتعاد بعد التصحيح
  IGNORED
}

/**
 * كل طلب وصل من سلة أو زد: آخر نسخة منه وحالة مزامنته
 */
model ExternalOrder {
  id          String              @id @default(cuid())
  source      String // SALLA | ZID
  externalId  String
  reference   String?
  status      ExternalOrderStatus
  storeStatus String?
  orderId     String?
  payload     Json
  missingSkus String[]
  error       String?
  attempts    Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([source, externalId])
  @@index([status])
}
