# قاعدة البيانات (Neon في الإنتاج، Postgres محلي في التطوير)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saif_dev"
# الرابط المباشر (بدون pooler) — للـ migrations. محليًا نفس DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saif_dev"
# قاعدة الاختبارات — بتتمسح بالكامل مع كل تشغيل للاختبارات
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/saif_test"

# حساب المالك الأول (يُستخدم في seed فقط)
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-to-a-long-password"
OWNER_NAME="المالك"

# سر توقيع الجلسات (32 حرف عشوائي على الأقل): openssl rand -base64 32
SESSION_SECRET="replace-with-random-32+chars"

# اختياري: مسار Chrome/Chromium لتوليد PDF عروض الأسعار محليًا (على Vercel مش محتاج)
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
